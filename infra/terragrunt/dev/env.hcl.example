# Environment-specific variables for the dev environment.
#
# Copy this file to env.hcl and set subscription_id before running terragrunt:
#   cp env.hcl.example env.hcl
#
# env.hcl is gitignored because it holds your Azure subscription id.

locals {
  environment     = "dev"
  location        = "northeurope"
  project         = "sb"
  subscription_id = "YOUR_SUBSCRIPTION_ID_HERE" # TODO: replace with your Azure subscription ID
}
