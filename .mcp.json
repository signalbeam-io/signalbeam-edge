{
  "mcpServers": {
    "signalbeam-validator": {
      "command": "node",
      "args": ["tools/signalbeam-validator/dist/index.js"],
      "env": {
        "REPO_ROOT": "."
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
