# Build artifacts
**/bin/
**/obj/
**/out/

# IDE and editor files
**/.vs/
**/.vscode/
**/.idea/
**/.DS_Store

# Dependencies
**/node_modules/

# Git
.git/
.gitignore
.gitattributes

# Docker
**/.dockerignore
**/Dockerfile*
**/docker-compose*

# Documentation (except EdgeAgent README)
*.md
!src/EdgeAgent/README.md

# Package build artifacts
**/package/build/

# systemd files (not needed in container)
**/systemd/

# NOTE: do not exclude src/<service>/ or src/SignalBeam.ServiceDefaults/ here.
# All service image builds use the repo root as build context and share this
# file, so excluding any service dir breaks that service's own COPY steps.

# Tests
tests/
**/*.Tests/

# Web frontend
web/

# Infrastructure
infra/
deploy/

# Scripts
scripts/

# Miscellaneous
Tiltfile
docker-compose.yml
CLAUDE.EXTENDED.md
