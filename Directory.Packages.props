<Project>
  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive dependencies to patched versions without forcing a direct
         reference in every project (keeps the Domain layer dependency-free). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Security transitive pins">
    <!-- Force OpenTelemetry.Api to the patched version (GHSA-g94r-2vxg-569j). -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
    <!-- Pin transitive ASP.NET Core / crypto packages (pulled via Microsoft.Identity.Web)
         to the latest 10.0.x servicing release to clear NU1903/NU1904 audit advisories
         (GHSA-9mv3-2cwr-p262, GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
    <!-- Cryptography.Xml / .Pkcs 10.0.14 clear GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7,
         GHSA-23rf-6693-g89p, GHSA-r955-8q5j-3h83 and related advisories (patched in 10.0.10–10.0.13). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Pin MessagePack (pulled transitively by the Aspire AppHost / dashboard) to the
         latest patched 2.5.x release to clear GHSA-hv8m-jj95-wg3x and GHSA-qhrr-8q5h-9q3h without the 3.x major bump. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- Pin Microsoft.OpenApi (pulled transitively via Scalar / AspNetCore.OpenApi) to the first
         patched release to clear GHSA-v5pm-xwqc-g5wc (NU1903). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
  </ItemGroup>
  <ItemGroup Label="Messaging and CQRS">
    <PackageVersion Include="WolverineFx" Version="5.27.0" />
    <PackageVersion Include="WolverineFx.Http" Version="5.27.0" />
  </ItemGroup>
  <ItemGroup Label="Data Access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
  </ItemGroup>
  <ItemGroup Label="Cloud-Native Integrations">
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="NATS.Client.Core" Version="2.7.2" />
    <PackageVersion Include="NATS.Client.JetStream" Version="2.7.2" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.23" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
  </ItemGroup>
  <ItemGroup Label="Container Management">
    <!-- Docker.DotNet.Enhanced is the maintained fork Testcontainers 4.11 depends on.
         The EdgeAgent uses the same fork (namespace-compatible) so the test project
         doesn't end up with two conflicting Docker.DotNet assemblies. -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="3.131.1" />
  </ItemGroup>
  <ItemGroup Label="Hosting and Configuration">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
  <ItemGroup Label="System Monitoring">
    <PackageVersion Include="System.Management" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Authentication and Authorization">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
  </ItemGroup>
  <ItemGroup Label="API Documentation">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
  </ItemGroup>
  <ItemGroup Label="API Gateway">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.2-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>
  <ItemGroup Label="Resilience">
    <PackageVersion Include="Polly" Version="8.9.1" />
    <PackageVersion Include="Polly.Extensions" Version="8.5.0" />
  </ItemGroup>
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>
  <ItemGroup Label="Serialization">
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Health Checks">
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.AzureBlobStorage" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label=".NET Aspire">
    <PackageVersion Include="Aspire.Hosting" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.NodeJs" Version="9.5.2" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.2.1" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Testcontainers" Version="4.11.0" />
    <!-- Pin SSH.NET (transitive via Testcontainers, used only for its SSH port forwarding) to
         2026.0.0 to clear GHSA-mggc-4xg6-vcxf / GHSA-q939-rpr3-3284. Newer Testcontainers
         releases ship it but require Docker.DotNet.Enhanced 4.x, a major bump for the EdgeAgent. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Code Analyzers">
    <PackageVersion Include="Roslynator.Analyzers" Version="4.12.9" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.4.0.108396" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
  </ItemGroup>
</Project>
